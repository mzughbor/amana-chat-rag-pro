{
    "name": "amana-rag",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "lint": "next lint",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "db:generate": "prisma generate",
        "postinstall": "echo 'Skipping prisma generate in postinstall'",
        "docker:build": "docker build -t amana-rag .",
